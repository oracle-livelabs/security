#cloud-config
write_files:
  - path: /home/opc/.deep-sec-genai-defaults
    owner: opc:opc
    permissions: '0600'
    content: |
      # Generated by the Deep Sec MarketplaceSeparate Terraform deployment. Contains no credentials.
      OCI_REGION="${region}"
      GENAI_COMPARTMENT_OCID="${genai_compartment_ocid}"
      GENAI_MODEL_ID="${genai_model_id}"
  - path: /home/opc/.deep-sec-order-history-credentials
    owner: opc:opc
    permissions: '0600'
    content: |
      ORDER_HISTORY_BUCKET="${order_history_bucket}"
      ORDER_HISTORY_NAMESPACE="${order_history_namespace}"
      ORDER_HISTORY_PREFIX="${order_history_prefix}"
      ORDER_HISTORY_ACCESS_KEY="${order_history_access_key}"
      ORDER_HISTORY_SECRET_KEY="${order_history_secret_key}"
      ORDER_HISTORY_OCI_USERNAME="${order_history_oci_username}"
      ORDER_HISTORY_OCI_AUTH_TOKEN="${order_history_oci_auth_token}"
      ORDER_HISTORY_METADATA_URL="${order_history_metadata_url}"
      ORDER_HISTORY_BUNDLE_ARCHIVE_URL="${order_history_bundle_archive_url}"
      ORDER_HISTORY_BUNDLE_WRITE_PAR_URLS='${order_history_bundle_write_par_urls}'
      ORDER_HISTORY_BUNDLE_ARCHIVE_SHA256="${order_history_bundle_archive_sha256}"
      ORDER_HISTORY_OCI_EXPORT_PREFIX="${order_history_export_prefix}"
  - path: /home/opc/.deep-sec-lab-password
    owner: opc:opc
    permissions: '0600'
    content: |
      ${jupyter_password}
  - path: /home/opc/.deep-sec-lab-environment
    owner: opc:opc
    permissions: '0600'
    content: |
      # Generated by the Deep Sec MarketplaceSeparate Terraform deployment. Do not add to source control.
      export LAB_PWD='${jupyter_password}'
      # Applications use the ADB LOW TLS descriptor. The VM shell keeps a
      # stable deepsec_low alias so SQL*Plus can use the familiar
      # admin/$LAB_PWD@deepsec_low connection form without an ADB wallet.
      export DEEP_SEC_DB_NAME='${adb_db_name}'
      export DEEP_SEC_DSN='${adb_tls_connection_string}'
      export TNS_ADMIN='/home/opc/deep-sec-network-admin'
  - path: /home/opc/deep-sec-network-admin/tnsnames.ora
    owner: opc:opc
    permissions: '0600'
    content: |
      # Stable Deep Sec ADB TLS alias. No wallet is required.
      deepsec_low = ${adb_tls_connection_string}
  - path: /home/opc/.deep-sec-wallet-download-url
    owner: opc:opc
    permissions: '0600'
    content: |
      ${wallet_par_url}
  - path: /home/opc/.deep-sec-jupyter-terminal-title.sh
    owner: opc:opc
    permissions: '0644'
    content: |
      # Jupyter may source .bashrc more than once for one terminal. Assign one
      # title per shell, not once per .bashrc evaluation.
      if [[ -n "$${JUPYTER_SERVER_ROOT:-}" && -n "$${PS1:-}" && -z "$${DEEPSEC_JUPYTER_TERMINAL_TITLE_ASSIGNED:-}" ]]; then
        export DEEPSEC_JUPYTER_TERMINAL_TITLE_ASSIGNED=1
        STATE=/tmp/.deep-sec-jupyter-terminal-count
        LOCK=/tmp/.deep-sec-jupyter-terminal-count.lock

        {
          flock 9

          terminal_count=0
          if [[ -f "$STATE" ]]; then
            read -r terminal_count < "$STATE" || terminal_count=0
          fi
          terminal_count=$((terminal_count + 1))
          printf '%s\n' "$terminal_count" > "$STATE"

          case "$terminal_count" in
            1) JUPYTER_TERMINAL_TITLE="Terminal A" ;;
            2) JUPYTER_TERMINAL_TITLE="Terminal B" ;;
            *) JUPYTER_TERMINAL_TITLE="Terminal $terminal_count" ;;
          esac
        } 9>"$LOCK"

        PS1="$${PS1}\[\033]0;$${JUPYTER_TERMINAL_TITLE}\007\]"
      fi
  - path: /home/opc/.deep-sec-sqlpath.sh
    owner: opc:opc
    permissions: '0644'
    content: |
      # Makes the checked-in lab scripts available to SQL*Plus by filename.
      deep_sec_sqlpath=/opt/deep-sec-admin-console/content/deep_data_security/database
      case ":$${SQLPATH:-}:" in
        *:$${deep_sec_sqlpath}:*) ;;
        *) export SQLPATH="$${deep_sec_sqlpath}$${SQLPATH:+:$${SQLPATH}}" ;;
      esac
  - path: /home/opc/reset_deep-sec_terminal_titles.sh
    owner: opc:opc
    permissions: '0755'
    content: |
      #!/usr/bin/env bash
      set -Eeuo pipefail

      rm -f /tmp/.deep-sec-jupyter-terminal-count \
        /tmp/.deep-sec-jupyter-terminal-count.lock
      echo "Terminal titles reset. Close existing Jupyter terminals, then open Terminal A followed by Terminal B."
  - path: /usr/local/sbin/configure-deep-sec-jupyter-terminal-titles
    owner: root:root
    permissions: '0755'
    content: |
      #!/usr/bin/env bash
      set -Eeuo pipefail

      bashrc=/home/opc/.bashrc
      title_source_line='[[ -f /home/opc/.deep-sec-jupyter-terminal-title.sh ]] && source /home/opc/.deep-sec-jupyter-terminal-title.sh'
      password_source_line='[[ -r /home/opc/.deep-sec-lab-password ]] && export LAB_PWD="$(< /home/opc/.deep-sec-lab-password)"'
      environment_source_line='[[ -r /home/opc/.deep-sec-lab-environment ]] && source /home/opc/.deep-sec-lab-environment'
      sqlpath_source_line='[[ -f /home/opc/.deep-sec-sqlpath.sh ]] && source /home/opc/.deep-sec-sqlpath.sh'

      touch "$bashrc"
      if ! grep -Fqx "$title_source_line" "$bashrc"; then
        printf '\n# Deep Sec labels Jupyter terminals in opening order.\n%s\n' "$title_source_line" >> "$bashrc"
      fi
      if ! grep -Fqx "$password_source_line" "$bashrc"; then
        printf '# Deep Sec loads the generated disposable lab password for terminal use.\n%s\n' "$password_source_line" >> "$bashrc"
      fi
      if ! grep -Fqx "$environment_source_line" "$bashrc"; then
        printf '# Deep Sec loads the database connection environment for terminal use.\n%s\n' "$environment_source_line" >> "$bashrc"
      fi
      if ! grep -Fqx "$sqlpath_source_line" "$bashrc"; then
        printf '# Deep Sec makes the checked-in SQL scripts available to SQL*Plus.\n%s\n' "$sqlpath_source_line" >> "$bashrc"
      fi
      chown opc:opc "$bashrc"
      chmod 0644 "$bashrc"
      rm -f /tmp/.deep-sec-jupyter-terminal-count \
        /tmp/.deep-sec-jupyter-terminal-count.lock
      echo "Deep Sec Jupyter terminal titles are configured."
  - path: /usr/local/sbin/download-deep-sec-lab-files
    owner: root:root
    permissions: '0755'
    content: |
      #!/usr/bin/env bash
      set -Eeuo pipefail

      home_dir=/home/opc

      download_file() {
        local destination="$1"
        local source_url="$2"
        local temporary="$${destination}.part"
        local attempt

        rm -f "$temporary"
        for attempt in 1 2 3; do
          echo "Downloading $source_url to $destination (attempt $attempt of 3)"
          # Force IPv4 here. The lab image can receive an IPv6 DNS answer
          # before its IPv6 egress route is usable; wget -q hid that failure
          # and made a valid Object Storage PAR look like a bad URL.
          if runuser -u opc -- curl -4 --fail --location --show-error --silent \
              --connect-timeout 20 --max-time 120 --output "$temporary" "$source_url" && \
             [[ -s "$temporary" ]] && unzip -tqq "$temporary"; then
            mv "$temporary" "$destination"
            return 0
          fi
          rm -f "$temporary"
          echo "Download attempt $attempt failed." >&2
        done

        echo "Could not download $source_url after three attempts." >&2
        return 1
      }

      download_file \
        "$home_dir/deep-data-security-flask-app.zip" \
        "${application_par_url}"
      unzip -p "$home_dir/deep-data-security-flask-app.zip" 'vibe-cli.zip' > "$home_dir/vibe-cli.zip"
      [[ -s "$home_dir/vibe-cli.zip" ]] || {
        echo 'The application archive does not contain the embedded Vibe CLI package.' >&2
        exit 1
      }
      unzip -tqq "$home_dir/vibe-cli.zip"

      echo "Deep Sec lab files are ready in $home_dir."
  - path: /usr/local/sbin/download-deep-sec-wallet
    owner: root:root
    permissions: '0755'
    content: |
      #!/usr/bin/env bash
      set -Eeuo pipefail

      home_dir=/home/opc
      wallet_url_file="$home_dir/.deep-sec-wallet-download-url"
      wallet_archive="$home_dir/.deep-sec-wallet.zip"
      wallet_directory="$home_dir/deep-sec-wallet/tns_admin"
      temporary_archive="$${wallet_archive}.part"
      log_root=/var/log/deep-sec
      run_log_dir="$${DEEP_SEC_RUN_LOG_DIR:-$log_root/runs/manual-$(date -u +%Y%m%dT%H%M%SZ)}"
      install -d -m 0750 "$run_log_dir"
      wallet_download_log="$run_log_dir/wallet-download.log"

      [[ -s "$wallet_url_file" ]] || {
        echo "Deep Sec wallet download URL is missing or empty." >&2
        exit 1
      }
      wallet_url=$(< "$wallet_url_file")
      : > "$wallet_download_log"
      chmod 0644 "$wallet_download_log"

      rm -f "$temporary_archive" "$wallet_archive"
      for attempt in 1 2 3; do
        echo "Downloading the generated ADB wallet (attempt $attempt of 3)"
        if runuser -u opc -- wget --https-only --timeout=30 --tries=1 -O "$temporary_archive" "$wallet_url" >> "$wallet_download_log" 2>&1 && \
           [[ -s "$temporary_archive" ]] && unzip -tqq "$temporary_archive"; then
          mv "$temporary_archive" "$wallet_archive"
          break
        fi
        rm -f "$temporary_archive"
        if [[ "$attempt" == 3 ]]; then
          echo "Could not download the generated ADB wallet after three attempts." >&2
          echo "Last 40 wallet-download diagnostic lines:" >&2
          tail -n 40 "$wallet_download_log" >&2 || true
          exit 1
        fi
      done

      rm -rf "$wallet_directory"
      mkdir -p "$wallet_directory"
      unzip -q "$wallet_archive" -d "$wallet_directory"
      for required_file in cwallet.sso ewallet.p12 sqlnet.ora tnsnames.ora; do
        [[ -s "$wallet_directory/$required_file" ]] || {
          echo "Downloaded wallet is missing $required_file." >&2
          exit 1
        }
      done
      # OCI wallet archives use the Instant Client default (?/network/admin).
      # This VM keeps its generated wallet in a protected per-lab directory.
      escaped_wallet_directory=$(printf '%s' "$wallet_directory" | sed 's/[&|\\]/\\&/g')
      sed -i "s|DIRECTORY=\"?/network/admin\"|DIRECTORY=\"$escaped_wallet_directory\"|g" "$wallet_directory/sqlnet.ora"
      grep -F "DIRECTORY=\"$wallet_directory\"" "$wallet_directory/sqlnet.ora" >/dev/null || {
        echo "Wallet sqlnet.ora does not point to $wallet_directory." >&2
        exit 1
      }
      actual_service_alias='${adb_actual_service_alias}'
      lab_service_alias='${adb_service_alias}'
      tnsnames_file="$wallet_directory/tnsnames.ora"
      if ! grep -Eq "^[[:space:]]*$lab_service_alias[[:space:]]*=" "$tnsnames_file"; then
        alias_block=$(awk -v actual="$actual_service_alias" -v alias="$lab_service_alias" '
          $0 ~ ("^[[:space:]]*" actual "[[:space:]]*=") {
            capture = 1
            sub(actual, alias)
            print
            next
          }
          capture && $0 ~ /^[^[:space:]#][^=]*=/ { exit }
          capture { print }
        ' "$tnsnames_file")
        [[ -n "$alias_block" ]] || {
          echo "Wallet does not contain the generated service alias: $actual_service_alias" >&2
          exit 1
        }
        printf '\n# Stable Deep Sec lab alias.\n%s\n' "$alias_block" >> "$tnsnames_file"
      fi
      grep -Eq "^[[:space:]]*$lab_service_alias[[:space:]]*=" "$tnsnames_file" || {
        echo "Could not add the stable Deep Sec service alias: $lab_service_alias" >&2
        exit 1
      }
      chown -R opc:opc "$wallet_directory"
      chmod 0700 "$wallet_directory"
      find "$wallet_directory" -type f -exec chmod 0600 {} +
      rm -f "$wallet_archive" "$wallet_url_file"
      echo "Deep Sec ADB wallet is ready at $wallet_directory."
  - path: /usr/local/sbin/configure-deep-sec-jupyter-password
    owner: root:root
    permissions: '0755'
    content: |
      #!/usr/bin/env bash
      set -Eeuo pipefail

      password_file=/home/opc/.deep-sec-lab-password
      config_dir=/home/opc/.jupyter
      config_file="$config_dir/jupyter_server_config.py"
      jupyter_python=/opt/jupyter/bin/python
      jupyter_service=jupyter-opc.service

      [[ -s "$password_file" ]] || {
        echo "Deep Sec Jupyter password file is missing or empty." >&2
        exit 1
      }
      [[ -x "$jupyter_python" ]] || {
        echo "Expected Jupyter Python runtime is missing: $jupyter_python" >&2
        exit 1
      }

      password_hash=$(runuser -u opc -- "$jupyter_python" - "$password_file" <<'PY'
      from pathlib import Path
      import sys

      from jupyter_server.auth import passwd

      print(passwd(Path(sys.argv[1]).read_text(encoding="utf-8").strip()))
      PY
      )

      install -d -m 0700 -o opc -g opc "$config_dir"
      touch "$config_file"
      chown opc:opc "$config_file"
      chmod 0600 "$config_file"
      sed -i '/# BEGIN Deep Sec Terraform password/,/# END Deep Sec Terraform password/d' "$config_file"
      printf '%s\n' \
        '' \
        '# BEGIN Deep Sec Terraform password' \
        '# Generated by the Deep Sec Terraform deployment.' \
        "c.ServerApp.password = u'$password_hash'" \
        '# END Deep Sec Terraform password' \
        >> "$config_file"
      if ! systemctl cat "$jupyter_service" >/dev/null 2>&1; then
        echo "Expected Jupyter service was not found: $jupyter_service" >&2
        exit 1
      fi
      systemctl restart "$jupyter_service"
      echo "Deep Sec Jupyter password configured and $jupyter_service restarted."
  - path: /usr/local/sbin/deep-sec-service-preflight
    owner: root:root
    permissions: '0755'
    content: |
      #!/usr/bin/env bash
      # Runs as the application service user before Gunicorn starts. It produces
      # a precise journal error for the common boot-order and wallet problems.
      set -Eeuo pipefail

      service_name="$1"
      case "$service_name" in
        admin)
          app_dir=/opt/deep-sec-admin-console
          python_bin="$app_dir/.venv/bin/python"
          app_file="$app_dir/admin_app.py"
          ;;
        customer)
          app_dir=/opt/deep-sec-customer-sales
          python_bin="$app_dir/.venv/bin/python"
          app_file="$app_dir/app.py"
          ;;
        *)
          echo "Unknown Deep Sec service name: $service_name" >&2
          exit 2
          ;;
      esac

      [[ -x "$python_bin" ]] || { echo "Missing Python runtime: $python_bin" >&2; exit 1; }
      [[ -r "$app_file" ]] || { echo "Missing application source: $app_file" >&2; exit 1; }
      [[ -n "$${ADMIN_DB_DSN:-}$${DB_DSN:-}" ]] || { echo 'Database TLS descriptor is not set in the service environment.' >&2; exit 1; }
      echo "Deep Sec $service_name preflight passed: app=$app_file walletless_tls=true"
  - path: /usr/local/sbin/deep-sec-wait-for-http
    owner: root:root
    permissions: '0755'
    content: |
      #!/usr/bin/env bash
      set -Eeuo pipefail

      port="$1"
      name="$2"
      for attempt in $(seq 1 30); do
        if curl --fail --silent --show-error --max-time 2 "http://127.0.0.1:$port/healthz"; then
          echo "Deep Sec $name health endpoint is ready on port $port."
          exit 0
        fi
        sleep 1
      done
      echo "Deep Sec $name did not become healthy on port $port within 30 seconds." >&2
      exit 1
  - path: /usr/local/sbin/deep-sec-status
    owner: root:root
    permissions: '0755'
    content: |
      #!/usr/bin/env bash
      # One command for handoff support on these disposable training VMs.
      set -u

      status=0
      show_service() {
        local service="$1"
        local port="$2"
        printf '\n===== %s =====\n' "$service"
        systemctl status "$service" --no-pager -l || status=1
        printf '\nHealth endpoint: '
        if curl --fail --silent --show-error --max-time 5 "http://127.0.0.1:$port/healthz"; then
          printf '\n'
        else
          printf '\n'
          status=1
        fi
        printf '\nRecent journal entries:\n'
        journalctl -u "$service" -b -n 100 --no-pager -o short-iso || status=1
      }

      printf '===== Deep Sec bootstrap =====\n'
      cloud-init status --long || status=1
      if [[ -L /var/log/deep-sec/latest ]]; then
        printf '\nLatest detailed run directory: %s\n' "$(readlink -f /var/log/deep-sec/latest)"
        find -L /var/log/deep-sec/latest -maxdepth 1 -type f -printf '  %f\n' | sort
      fi
      [[ -f /var/log/deep-sec-bootstrap.log ]] && {
        printf '\nRecent high-level bootstrap log:\n'
        tail -n 100 /var/log/deep-sec-bootstrap.log
      }
      printf '\n===== Listening sockets =====\n'
      ss -ltnp '( sport = :7777 or sport = :7778 or sport = :8888 )' || status=1
      show_service deep-sec-admin-console.service 7778
      show_service deep-sec-customer-sales.service 7777
      exit "$status"
  - path: /usr/local/sbin/bootstrap-deep-sec
    owner: root:root
    permissions: '0755'
    content: |
      #!/usr/bin/env bash
      # Cloud-init invokes this one orchestrator. The durable top-level log is
      # deliberately concise; every invocation gets its own detailed run directory.
      set -Eeuo pipefail

      log_file=/var/log/deep-sec-bootstrap.log
      log_root=/var/log/deep-sec
      runs_dir="$log_root/runs"
      run_id=$(date -u +%Y%m%dT%H%M%SZ)
      run_dir="$runs_dir/$run_id"
      state_dir=/var/lib/deep-sec
      status_file="$state_dir/bootstrap-status"
      bootstrap_status_write_url='${bootstrap_status_write_par_url}'
      install -d -m 0755 "$state_dir" "$runs_dir"
      install -d -m 0750 "$run_dir"
      ln -sfn "$run_dir" "$log_root/latest"
      export DEEP_SEC_RUN_LOG_DIR="$run_dir"
      touch "$log_file"
      chmod 0644 "$log_file"

      timestamp() { date --iso-8601=seconds; }
      high_level() {
        local message="$1"
        printf '[%s] %s\n' "$(timestamp)" "$message" >> "$log_file"
        logger -t deep-sec-bootstrap -- "[$(timestamp)] $message"
      }
      phase() { high_level "===== $1 ====="; }
      run_phase() {
        local phase_name="$1"
        local detail_name="$2"
        shift 2
        local detail_log="$run_dir/$detail_name"
        phase "$phase_name"
        printf '[%s] START %s\n' "$(timestamp)" "$phase_name" > "$detail_log"
        printf 'RUNNING %s run=%s phase=%s details=%s\n' \
          "$(timestamp)" "$run_id" "$phase_name" "$detail_log" > "$status_file"
        publish_status || true
        if "$@" >> "$detail_log" 2>&1; then
          high_level "COMPLETE $phase_name; details=$detail_log"
        else
          local exit_code=$?
          high_level "FAILED $phase_name (exit=$exit_code); details=$detail_log"
          printf 'FAILED %s run=%s exit_code=%s phase=%s details=%s\n' \
            "$(timestamp)" "$run_id" "$exit_code" "$phase_name" "$detail_log" > "$status_file"
          publish_status || true
          return "$exit_code"
        fi
      }
      run_optional_phase() {
        local phase_name="$1"
        local detail_name="$2"
        shift 2
        local detail_log="$run_dir/$detail_name"
        phase "$phase_name (best effort)"
        printf '[%s] START %s (best effort)\n' "$(timestamp)" "$phase_name" > "$detail_log"
        if "$@" >> "$detail_log" 2>&1; then
          high_level "COMPLETE $phase_name; details=$detail_log"
        else
          local exit_code=$?
          high_level "WARNING: optional $phase_name failed (exit=$exit_code); continuing; details=$detail_log"
        fi
      }
      prune_old_runs() {
        local -a old_runs=()
        mapfile -t old_runs < <(find "$runs_dir" -mindepth 1 -maxdepth 1 -type d -printf '%T@ %p\n' | sort -nr | awk 'NR > 10 {print $2}')
        (($${#old_runs[@]} == 0)) || rm -rf -- "$${old_runs[@]}"
      }
      publish_status() {
        curl --fail --silent --show-error --retry 3 --retry-delay 2 \
          --connect-timeout 5 --max-time 30 \
          --upload-file "$status_file" "$bootstrap_status_write_url"
      }
      failed() {
        local exit_code="$1"
        high_level "FAILED: bootstrap exited with status $exit_code; details=$run_dir"
        if ! grep -q '^FAILED ' "$status_file" 2>/dev/null; then
          printf 'FAILED %s run=%s exit_code=%s phase=unreported details=%s\n' \
            "$(timestamp)" "$run_id" "$exit_code" "$run_dir" > "$status_file"
        fi
        publish_status || true
        /usr/local/sbin/deep-sec-status > "$run_dir/deep-sec-status-on-failure.log" 2>&1 || true
        prune_old_runs
        exit "$exit_code"
      }
      trap 'failed $?' ERR

      high_level "START run=$run_id details=$run_dir"
      printf 'RUNNING %s run=%s phase=initializing details=%s\n' \
        "$(timestamp)" "$run_id" "$run_dir" > "$status_file"
      publish_status || true
      run_phase 'Configure Jupyter terminal environment' jupyter-terminal.log /usr/local/sbin/configure-deep-sec-jupyter-terminal-titles
      # Marketplace intentionally does not deliver an ADB wallet.
      run_phase 'Configure Jupyter password' jupyter-password.log /usr/local/sbin/configure-deep-sec-jupyter-password
      run_phase 'Download and validate application packages' lab-download.log /usr/local/sbin/download-deep-sec-lab-files
      # The separately published archive is the complete pre-created table.
      # The VM rewrites its metadata graph for the Stack-created bucket and
      # publishes the files through exact-object PARs.
      run_phase 'Publish pre-created Order History Iceberg bundle' order-history-generator.log /usr/local/sbin/generate-deep-sec-order-history
      run_phase 'Install and start Deep Sec applications' admin-console-install.stdout.log /usr/local/sbin/install-deep-sec-admin-console
      run_phase 'Install Vibe Coding' vibe-install.log /usr/local/sbin/install-deep-sec-vibe
      run_phase 'Verify application services' service-status.log /usr/local/sbin/deep-sec-status
      printf 'COMPLETE %s run=%s details=%s\n' "$(timestamp)" "$run_id" "$run_dir" > "$status_file"
      publish_status
      high_level "COMPLETE run=$run_id details=$run_dir"
      prune_old_runs
  - path: /usr/local/sbin/generate-deep-sec-order-history
    owner: root:root
    permissions: '0755'
    content: |
      #!/usr/bin/env bash
      set -Eeuo pipefail

      home_dir=/home/opc
      package_file="$home_dir/deep-data-security-flask-app.zip"
      setup_dir=/opt/deep-sec-setup
      generator_venv=/opt/deep-sec-order-history/.venv
      log_root=/var/log/deep-sec
      run_log_dir="$${DEEP_SEC_RUN_LOG_DIR:-$log_root/runs/manual-$(date -u +%Y%m%dT%H%M%SZ)}"
      install -d -m 0750 "$run_log_dir"
      generator_log="$run_log_dir/order-history-generator.log"

      section() { printf '\n===== %s =====\n' "$1"; }
      run_logged() {
        local description="$1"
        shift
        if ! "$@" >> "$generator_log" 2>&1; then
          echo "ERROR: $description failed. Last 80 lines from $generator_log:" >&2
          tail -n 80 "$generator_log" >&2 || true
          return 1
        fi
      }

      [[ -s "$package_file" ]] || { echo "Missing lab package: $package_file" >&2; exit 1; }
      offline_dir=/opt/deep-sec-offline
      python_tag=$(/usr/bin/python3 -c 'import sys; print(f"py{sys.version_info.major}.{sys.version_info.minor}")')
      offline_wheelhouse="$offline_dir/wheelhouse/$python_tag"
      [[ -d "$offline_wheelhouse" ]] || {
        echo "The lab package has no wheelhouse for the system runtime: $python_tag" >&2
        exit 1
      }
      wheel_count=$(find "$offline_wheelhouse" -maxdepth 1 -type f -name '*.whl' -print | wc -l)
      (( wheel_count > 0 )) || {
        echo "The offline wheelhouse is empty: $offline_wheelhouse" >&2
        exit 1
      }
      : > "$generator_log"
      chmod 0644 "$generator_log"
      set -a
      source "$home_dir/.deep-sec-genai-defaults"
      source "$home_dir/.deep-sec-order-history-credentials"
      set +a
      section 'Publish pre-created Iceberg bundle'
      bundle_script=$(mktemp /tmp/materialize-order-history-bundle.XXXXXX.py)
      unzip -p "$package_file" 'setup/materialize_order_history_iceberg_bundle.py' > "$bundle_script"
      [[ -s "$bundle_script" ]] || {
        echo 'The lab package does not contain the Iceberg bundle materializer.' >&2
        exit 1
      }
      bundle_venv="$(dirname "$generator_venv")/.bundle-venv"
      rm -rf "$bundle_venv"
      install -d -m 0755 "$bundle_venv"
      /usr/bin/python3 -m venv "$bundle_venv"
      run_logged 'Iceberg bundle dependency installation from embedded wheelhouse' \
        "$bundle_venv/bin/python" -m pip install \
          --no-index --find-links="$offline_wheelhouse" \
          --disable-pip-version-check --no-input 'fastavro>=1.9,<2'
      run_logged 'Iceberg bundle dependency check' "$bundle_venv/bin/python" -m pip check
      run_logged 'Iceberg bundle materialization' "$bundle_venv/bin/python" "$bundle_script"
      rm -f "$bundle_script"
      echo "Published pre-created Apache Iceberg data in bucket $${ORDER_HISTORY_BUCKET} under prefix $${ORDER_HISTORY_OCI_EXPORT_PREFIX}."
      exit 0
  - path: /usr/local/sbin/install-deep-sec-admin-console
    owner: root:root
    permissions: '0755'
    content: |
      #!/usr/bin/env bash
      set -Eeuo pipefail

      home_dir=/home/opc
      package_file="$home_dir/deep-data-security-flask-app.zip"
      stage_dir=/var/tmp/deep-sec-admin-console-stage
      admin_dir=/opt/deep-sec-admin-console
      admin_database_dir=/opt/deep-sec-admin-console/content/deep_data_security/database
      admin_environment_file=/etc/deep-sec/admin-console.env
      admin_service_file=/etc/systemd/system/deep-sec-admin-console.service
      customer_stage_dir=/var/tmp/deep-sec-customer-sales-stage
      customer_dir=/opt/deep-sec-customer-sales
      customer_original_dir=/opt/deep-sec-customer-sales-orig-app
      customer_environment_file=/etc/deep-sec/customer-sales.env
      customer_service_file=/etc/systemd/system/deep-sec-customer-sales.service
      vibe_reload_sudoers=/etc/sudoers.d/deep-sec-vibe-reload
      log_root=/var/log/deep-sec
      run_log_dir="$${DEEP_SEC_RUN_LOG_DIR:-$log_root/runs/manual-$(date -u +%Y%m%dT%H%M%SZ)}"
      install -d -m 0750 "$run_log_dir"
      install_log="$run_log_dir/admin-console-install.log"
      bootstrap_log=/var/log/deep-sec-bootstrap.log

      section() { printf '\n===== %s =====\n' "$1"; }
      timestamp() { date --iso-8601=seconds; }
      run_logged() {
        local description="$1"
        shift
        printf '[%s] START %s\n' "$(timestamp)" "$description" >> "$bootstrap_log"
        printf 'START %s\n' "$description"
        if ! "$@" >> "$install_log" 2>&1; then
          printf '[%s] FAILED %s\n' "$(timestamp)" "$description" >> "$bootstrap_log"
          printf 'FAILED %s\n' "$description"
          echo "ERROR: $description failed. Last 80 lines from $install_log:" >&2
          tail -n 80 "$install_log" >&2 || true
          return 1
        fi
        printf '[%s] COMPLETE %s\n' "$(timestamp)" "$description" >> "$bootstrap_log"
        printf 'COMPLETE %s\n' "$description"
      }

      [[ -s "$package_file" ]] || { echo "Missing lab package: $package_file" >&2; exit 1; }
      offline_dir=/opt/deep-sec-offline
      python_tag=$(/usr/bin/python3 -c 'import sys; print(f"py{sys.version_info.major}.{sys.version_info.minor}")')
      offline_wheelhouse="$offline_dir/wheelhouse/$python_tag"
      [[ -d "$offline_wheelhouse" ]] || {
        echo "The lab package has no wheelhouse for the system runtime: $python_tag" >&2
        exit 1
      }
      wheel_count=$(find "$offline_wheelhouse" -maxdepth 1 -type f -name '*.whl' -print | wc -l)
      (( wheel_count > 0 )) || {
        echo "The offline wheelhouse is empty: $offline_wheelhouse" >&2
        exit 1
      }
      # Keep the full ADMIN database rebuild entry point on every VM, even
      # when optional Iceberg generation is skipped. It runs the installed
      # lesson database/*.sql sequence. The published bundle is already in
      # place before this reader setup runs.
      unzip -p "$package_file" 'setup/rebuild_deep_sec_database.sh' > /usr/local/sbin/rebuild-deep-sec-database
      chmod 0755 /usr/local/sbin/rebuild-deep-sec-database
      # Load all generated settings before set -u expands them into either
      # systemd environment file. The deferred Iceberg branch does not source
      # these files, so this must happen outside that optional branch.
      source "$home_dir/.deep-sec-lab-environment"
      source "$home_dir/.deep-sec-genai-defaults"
      source "$home_dir/.deep-sec-order-history-credentials"
      [[ -n "$${DEEP_SEC_DSN:-}" ]] || { echo 'Missing Marketplace database TLS descriptor.' >&2; exit 1; }
      # Marketplace uses walletless TLS. Keep this empty unless a future
      # deployment explicitly supplies a wallet for SQL*Plus.
      wallet_dir="$${TNS_ADMIN:-}"
      : > "$install_log"
      chmod 0644 "$install_log"
      command -v openssl >/dev/null || { echo 'openssl is required for the admin-console session secret.' >&2; exit 1; }

      section 'Install Administrator Console'
      systemctl stop deep-sec-admin-console.service 2>/dev/null || true
      systemctl stop deep-sec-customer-sales.service 2>/dev/null || true
      rm -rf "$stage_dir" "$admin_dir"
      mkdir -p "$stage_dir"
      unzip -q "$package_file" 'admin-app/*' -d "$stage_dir"
      mv "$stage_dir/admin-app" "$admin_dir"
      rm -rf "$stage_dir"
      chown -R opc:opc "$admin_dir"

      runuser -u opc -- /usr/bin/python3 -m venv "$admin_dir/.venv"
      run_logged 'Administrator Console dependency installation from embedded wheelhouse' \
        runuser -u opc -- "$admin_dir/.venv/bin/python" -m pip install \
          --no-index --find-links="$offline_wheelhouse" \
          --disable-pip-version-check --no-input -r "$admin_dir/requirements.txt"
      run_logged 'Administrator Console dependency check' runuser -u opc -- "$admin_dir/.venv/bin/python" -m pip check

      section 'Install database setup scripts'
      [[ -d "$admin_database_dir" ]] || {
        echo "Missing lesson database scripts at $admin_database_dir" >&2
        exit 1
      }
      chown -R opc:opc "$admin_database_dir"

      # Initialize the lesson database before any Iceberg bootstrap SQL runs.
      # A newly-created ADB is empty, while the generated Iceberg credential
      # and verification procedure are owned by APPLAB. The rebuild is the
      # same supported entry point exposed to learners for resetting the lab.
      section 'Initialize Deep Sec database'
      run_logged 'Initialize Deep Sec database' \
        runuser -u opc -- env \
          DEEP_SEC_DATABASE_DIR="$admin_database_dir" \
          TNS_ADMIN="$wallet_dir" \
          DEEP_SEC_DSN="$DEEP_SEC_DSN" \
          /usr/local/sbin/rebuild-deep-sec-database

      # Order History is part of the Marketplace deployment. Required inputs
      # must fail the bootstrap visibly rather than silently skipping setup.
      [[ -r "$home_dir/.deep-sec-genai-defaults" ]] || {
        echo 'Missing generated Deep Sec defaults for Order History bootstrap.' >&2
        exit 1
      }
      [[ -r "$home_dir/.deep-sec-order-history-credentials" ]] || {
        echo 'Missing generated Order History credentials for bootstrap.' >&2
        exit 1
      }
      source "$home_dir/.deep-sec-genai-defaults"
      source "$home_dir/.deep-sec-order-history-credentials"
      # These are direct grants because the generated definer-rights
      # procedure cannot use privileges inherited through a role. They match
      # the grants in create_order_history_table.sql and must precede its
      # DBMS_CLOUD credential procedure compilation.
      iceberg_privilege_sql=$(mktemp)
      chmod 0600 "$iceberg_privilege_sql"
      cat > "$iceberg_privilege_sql" <<SQL
      whenever oserror exit failure
      whenever sqlerror exit sql.sqlcode rollback
      connect admin/"$${LAB_PWD//\"/\"\"}"@$${DEEP_SEC_DSN}
      grant create session to APPLAB;
      grant create table, create procedure, create sequence to APPLAB;
      grant dwrole to APPLAB;
      grant execute on dbms_cloud to APPLAB;
      grant read, write on directory DATA_PUMP_DIR to APPLAB;
      exit
      SQL
      if ! run_logged 'Configure APPLAB Iceberg reader privileges' \
        runuser -u opc -- env TNS_ADMIN="$wallet_dir" sqlplus -s -L /nolog < "$iceberg_privilege_sql"; then
        rm -f "$iceberg_privilege_sql"
        exit 1
      fi
      rm -f "$iceberg_privilege_sql"

      if [[ -z "$${ORDER_HISTORY_OCI_USERNAME:-}" || -z "$${ORDER_HISTORY_OCI_AUTH_TOKEN:-}" ]]; then
        echo 'Order History OCI username and Auth Token are required for DBMS_CLOUD credential creation.' >&2
        exit 1
      fi
      sql_quote() { printf '%s' "$${1}" | sed "s/'/''/g"; }
      order_history_oci_username=$(sql_quote "$${ORDER_HISTORY_OCI_USERNAME}")
      order_history_oci_auth_token=$(sql_quote "$${ORDER_HISTORY_OCI_AUTH_TOKEN}")
      cat > "$admin_database_dir/create_order_history_reader_credential.sql" <<SQL
      -- Generated locally from sensitive Stack inputs. This file is invoked
      -- by the APPLAB setup session and is never displayed. DBMS_CLOUD stores
      -- the Object Storage credential in the schema that creates it.
      begin
        begin
          dbms_cloud.drop_credential('ORDER_HISTORY_OCI_CRED');
        exception
          when others then
            if sqlcode != -20004 then raise; end if;
        end;
        dbms_cloud.create_credential(
          credential_name => 'ORDER_HISTORY_OCI_CRED',
          username        => '$${order_history_oci_username}',
          password        => '$${order_history_oci_auth_token}'
        );
      end;
      /
      SQL
      order_history_reader_credential_name='ORDER_HISTORY_OCI_CRED'
      chown opc:opc "$admin_database_dir/create_order_history_reader_credential.sql"
      chmod 0600 "$admin_database_dir/create_order_history_reader_credential.sql"
      sed -i 's|-- ORDER_HISTORY_CREDENTIAL_SETUP|@@create_order_history_reader_credential.sql|' \
        "$admin_database_dir/create_order_history_table.sql"
      sed -i 's|-- ORDER_HISTORY_CREDENTIAL_SETUP|@@create_order_history_reader_credential.sql|' \
        "$admin_database_dir/create_order_history_table.display.sql"

      # Single source of truth for the credential used by Oracle's Iceberg
      # reader. OCI Resource Principal authentication is not supported for
      # Iceberg, so this uses the supplied OCI username and Auth Token.
      # Terraform points the standard path at the checked-in metadata JSON
      # published in the Stack-created Iceberg bucket.
      order_history_metadata_url="$${ORDER_HISTORY_METADATA_URL:-}"
      [[ -n "$order_history_metadata_url" ]] || {
        echo 'Order History metadata URL is required for external-table bootstrap.' >&2
        exit 1
      }
      for order_history_script in \
        "$admin_database_dir/create_order_history_table.sql" \
        "$admin_database_dir/create_order_history_table.display.sql"; do
        sed -i \
          -e "s|<region>|${region}|g" \
          -e "s|<namespace>|$${ORDER_HISTORY_NAMESPACE}|g" \
          -e "s|<bucket>|$${ORDER_HISTORY_BUCKET}|g" \
          -e "s|<order_history_metadata_url>|$${order_history_metadata_url}|g" \
          -e "s|READER_CREDENTIAL_NAME|$${order_history_reader_credential_name}|g" \
          "$order_history_script"
        if grep -F '<region>' "$order_history_script" >/dev/null || \
           grep -F '<namespace>' "$order_history_script" >/dev/null || \
           grep -F '<bucket>' "$order_history_script" >/dev/null || \
           grep -F '<order_history_metadata_url>' "$order_history_script" >/dev/null || \
           grep -F 'READER_CREDENTIAL_NAME' "$order_history_script" >/dev/null; then
          echo "Unresolved Iceberg Object Storage placeholder: $order_history_script" >&2
          exit 1
        fi
      done

      # Create the learner-facing external table during deployment. The
      # separate disposable table below remains the Resource Manager health
      # gate, but the real ORDER_HISTORY table must remain queryable after the
      # VM is ready so the lab starts with its data mounted.
      order_history_table_sqlplus_input=$(mktemp)
      chmod 0600 "$order_history_table_sqlplus_input"
      cat > "$order_history_table_sqlplus_input" <<SQL
      whenever oserror exit failure
      whenever sqlerror exit sql.sqlcode rollback
      connect applab/"$${LAB_PWD//\"/\"\"}"@$${DEEP_SEC_DSN}
      @$${admin_database_dir}/create_order_history_table.sql
      exit
      SQL
      run_logged 'Create learner Iceberg external table as APPLAB' \
        runuser -u opc -- env TNS_ADMIN="$wallet_dir" sqlplus -s -L /nolog < "$order_history_table_sqlplus_input"
      rm -f "$order_history_table_sqlplus_input"

      # Verify the external-table path with APPLAB and a disposable table when
      # the stack promised a generated dataset. This makes Resource Manager's
      # bootstrap gate mean the Iceberg reader is usable, not just that files
      # were written somewhere.
      order_history_bootstrap_verify_sql="$admin_database_dir/verify_order_history_bootstrap.sql"
      cat > "$order_history_bootstrap_verify_sql" <<SQL
      whenever sqlerror exit sql.sqlcode rollback
      set echo off

      begin
        execute immediate 'drop table ORDER_HISTORY_BOOTSTRAP_VERIFY purge';
      exception
        when others then
          if sqlcode != -942 then raise; end if;
      end;
      /

      -- APPLAB is the prepared schema and owns this credential and table.
      @$${admin_database_dir}/create_order_history_reader_credential.sql

      declare
        l_metadata_blob blob;
      begin
        l_metadata_blob := dbms_cloud.get_object(
          credential_name => '$${order_history_reader_credential_name}',
          object_uri      => '$${order_history_metadata_url}'
        );
        if dbms_lob.getlength(l_metadata_blob) = 0 then
          raise_application_error(-20001, 'Iceberg metadata object is empty.');
        end if;
      end;
      /

      begin
        dbms_cloud.create_external_table(
          table_name      => 'ORDER_HISTORY_BOOTSTRAP_VERIFY',
          credential_name => '$${order_history_reader_credential_name}',
          file_uri_list   => '$${order_history_metadata_url}',
          format          => json_object(
                               'access_protocol' value json_object(
                                 'protocol_type' value 'iceberg'
                               )
                             )
        );
      end;
      /

      declare
        l_order_id ORDER_HISTORY_BOOTSTRAP_VERIFY.order_id%type;
      begin
        select order_id
          into l_order_id
          from ORDER_HISTORY_BOOTSTRAP_VERIFY
         where rownum = 1;
      exception
        when no_data_found then
          raise_application_error(-20002, 'Iceberg ORDER_HISTORY returned no rows.');
      end;
      /

      drop table ORDER_HISTORY_BOOTSTRAP_VERIFY purge;
      exit
      SQL
      sed -i \
        -e 's|-- ORDER_HISTORY_CREDENTIAL_SETUP|@@create_order_history_reader_credential.sql|' \
        -e "s|<region>|${region}|g" \
        -e "s|READER_CREDENTIAL_NAME|$${order_history_reader_credential_name}|g" \
        "$order_history_bootstrap_verify_sql"
      if grep -F 'READER_CREDENTIAL_NAME' "$order_history_bootstrap_verify_sql" >/dev/null; then
        echo "Unresolved Iceberg credential placeholder: $order_history_bootstrap_verify_sql" >&2
        exit 1
      fi
      chown opc:opc "$order_history_bootstrap_verify_sql"
      chmod 0600 "$order_history_bootstrap_verify_sql"
      source "$home_dir/.deep-sec-lab-environment"
      order_history_bootstrap_sqlplus_input=$(mktemp)
      cat > "$order_history_bootstrap_sqlplus_input" <<SQL
      whenever oserror exit failure
      connect applab/"$${LAB_PWD//\"/\"\"}"@$${DEEP_SEC_DSN}
      @$${order_history_bootstrap_verify_sql}
      exit
      SQL
      run_logged 'Iceberg external-table and row-read bootstrap verification as APPLAB' \
        runuser -u opc -- env TNS_ADMIN="$wallet_dir" sqlplus -s -L /nolog < "$order_history_bootstrap_sqlplus_input"
      echo 'Iceberg external-table bootstrap verification succeeded.'
      rm -f "$order_history_bootstrap_sqlplus_input" "$order_history_bootstrap_verify_sql"

      section 'Install Customer Sales App'
      rm -rf "$customer_stage_dir" "$customer_dir" "$customer_original_dir"
      mkdir -p "$customer_stage_dir"
      unzip -q "$package_file" 'flask-app/*' -d "$customer_stage_dir"
      mv "$customer_stage_dir/flask-app" "$customer_dir"
      rm -rf "$customer_stage_dir"
      chown -R opc:opc "$customer_dir"

      runuser -u opc -- /usr/bin/python3 -m venv "$customer_dir/.venv"
      run_logged 'Customer Sales App dependency installation from embedded wheelhouse' \
        runuser -u opc -- "$customer_dir/.venv/bin/python" -m pip install \
          --no-index --find-links="$offline_wheelhouse" \
          --disable-pip-version-check --no-input -r "$customer_dir/requirements.txt"
      run_logged 'Customer Sales App dependency check' runuser -u opc -- "$customer_dir/.venv/bin/python" -m pip check
      cp -a "$customer_dir" "$customer_original_dir"
      chown -R opc:opc "$customer_original_dir"
      for app_file in app.py config.py db.py requirements.txt run.sh templates/index.html; do
        cmp -s "$customer_dir/$app_file" "$customer_original_dir/$app_file" || {
          echo "Original Customer Sales App copy does not match installed application: $app_file" >&2
          exit 1
        }
      done
      printf 'Protected original Customer Sales App verified: %s\n' "$customer_original_dir"

      section 'Configure and start Deep Sec services'
      install -d -m 0755 /etc/deep-sec
      install -d -o opc -g opc -m 0755 /var/lib/deep-sec
      if [[ ! -e /var/lib/deep-sec/vibe-reports.json ]]; then
        install -o opc -g opc -m 0640 /dev/null /var/lib/deep-sec/vibe-reports.json
        printf '{}\n' > /var/lib/deep-sec/vibe-reports.json
      fi
      umask 077
      admin_secret=$(openssl rand -hex 32)
      customer_secret=$(openssl rand -hex 32)
      printf '%s\n' \
        '# Generated by the Deep Sec Terraform deployment. Keep this file private.' \
        'ADMIN_FLASK_HOST=0.0.0.0' \
        'ADMIN_FLASK_PORT=7778' \
        'ADMIN_LOG_LEVEL=DEBUG' \
        "OCI_REGION=${region}" \
        "ORDER_HISTORY_BUCKET=$${ORDER_HISTORY_BUCKET}" \
        "ORDER_HISTORY_NAMESPACE=$${ORDER_HISTORY_NAMESPACE}" \
        "ORDER_HISTORY_PREFIX=$${ORDER_HISTORY_PREFIX}" \
        "ORDER_HISTORY_READ_PAR_URL=${order_history_read_par_url}" \
        "ORDER_HISTORY_METADATA_READ_PAR_URL=${order_history_metadata_read_par_url}" \
        'ORDER_HISTORY_OBJECT_READ_PAR_URLS=${order_history_object_read_par_urls}' \
        'PYTHONUNBUFFERED=1' \
        'PYTHONDONTWRITEBYTECODE=1' \
        "ADMIN_FLASK_SECRET_KEY=$admin_secret" \
        "ADMIN_DB_DSN=$${DEEP_SEC_DSN}" \
        "DEEP_SEC_DATABASE_DIR=$admin_database_dir" \
        'DEEP_SEC_VIBE_REPORTS_PATH=/var/lib/deep-sec/vibe-reports.json' \
        'ADMIN_VIBE_EXECUTABLE=/opt/deep-sec-vibe/bin/vibe' \
        "ADMIN_VIBE_PROJECT_ROOT=$customer_dir" \
        'VIBE_HOME=/opt/deep-sec-vibe/home' \
        'VIBE_CONFIG=/opt/deep-sec-vibe/config/config.toml' \
        'VIBE_LAB_CONTEXT=/opt/deep-sec-vibe/home/lab-context.md' \
        > "$admin_environment_file"
      chown root:root "$admin_environment_file"
      chmod 0600 "$admin_environment_file"
      printf '%s\n' \
        '# Generated by the Deep Sec Terraform deployment. Keep this file private.' \
        'FLASK_HOST=0.0.0.0' \
        'FLASK_PORT=7777' \
        'FLASK_DEBUG=false' \
        'FLASK_LOG_LEVEL=DEBUG' \
        'PYTHONUNBUFFERED=1' \
        'PYTHONDONTWRITEBYTECODE=1' \
        "FLASK_SECRET_KEY=$customer_secret" \
        "DB_DSN=$${DEEP_SEC_DSN}" \
        'DB_SCHEMA=APPLAB' \
        'DEEP_SEC_VIBE_REPORTS_PATH=/var/lib/deep-sec/vibe-reports.json' \
        "GENAI_DEFAULTS_FILE=$home_dir/.deep-sec-genai-defaults" \
        > "$customer_environment_file"
      chown root:root "$customer_environment_file"
      chmod 0600 "$customer_environment_file"
      restorecon -RF "$admin_dir" "$admin_database_dir" "$customer_dir" "$customer_original_dir" /etc/deep-sec

      cat > "$admin_service_file" <<'SERVICE'
      [Unit]
      Description=Deep Sec Administrator Console
      After=network-online.target
      Wants=network-online.target
      StartLimitIntervalSec=0
      StartLimitBurst=0

      [Service]
      Type=simple
      User=opc
      Group=opc
      WorkingDirectory=/opt/deep-sec-admin-console
      EnvironmentFile=/etc/deep-sec/admin-console.env
      ExecStartPre=/usr/local/sbin/deep-sec-service-preflight admin
      ExecStart=/opt/deep-sec-admin-console/.venv/bin/python -m gunicorn --bind 0.0.0.0:7778 --workers 1 --worker-class gthread --threads 4 --timeout 120 --graceful-timeout 30 --keep-alive 5 --max-requests 1000 --max-requests-jitter 100 --log-level debug --capture-output --access-logfile - --error-logfile - admin_app:app
      ExecStartPost=/usr/local/sbin/deep-sec-wait-for-http 7778 admin-console
      Restart=always
      RestartSec=3
      TimeoutStartSec=180
      TimeoutStopSec=150
      SyslogIdentifier=deep-sec-admin-console
      StandardOutput=journal
      StandardError=journal

      [Install]
      WantedBy=multi-user.target
      SERVICE

      cat > "$customer_service_file" <<'SERVICE'
      [Unit]
      Description=Deep Sec Customer Sales App
      After=network-online.target
      Wants=network-online.target
      StartLimitIntervalSec=0
      StartLimitBurst=0

      [Service]
      Type=simple
      User=opc
      Group=opc
      WorkingDirectory=/opt/deep-sec-customer-sales
      EnvironmentFile=/etc/deep-sec/customer-sales.env
      ExecStartPre=/usr/local/sbin/deep-sec-service-preflight customer
      ExecStart=/opt/deep-sec-customer-sales/.venv/bin/python -m gunicorn --bind 0.0.0.0:7777 --workers 1 --worker-class gthread --threads 4 --timeout 120 --graceful-timeout 30 --keep-alive 5 --max-requests 1000 --max-requests-jitter 100 --log-level debug --capture-output --access-logfile - --error-logfile - app:app
      ExecStartPost=/usr/local/sbin/deep-sec-wait-for-http 7777 customer-sales
      ExecReload=/bin/kill -HUP $MAINPID
      Restart=always
      RestartSec=3
      TimeoutStartSec=180
      TimeoutStopSec=30
      SyslogIdentifier=deep-sec-customer-sales
      StandardOutput=journal
      StandardError=journal

      [Install]
      WantedBy=multi-user.target
      SERVICE

      if command -v firewall-cmd >/dev/null 2>&1 && systemctl is-active --quiet firewalld; then
        firewall-cmd --permanent --add-port=7777/tcp
        firewall-cmd --permanent --add-port=7778/tcp
        firewall-cmd --reload
      fi
      run_logged 'systemd service verification' systemd-analyze verify "$admin_service_file" "$customer_service_file"
      printf '%s\n' 'opc ALL=(root) NOPASSWD: /usr/bin/systemctl reload deep-sec-customer-sales.service' > "$vibe_reload_sudoers"
      chmod 0440 "$vibe_reload_sudoers"
      run_logged 'Vibe sudoers verification' visudo -cf "$vibe_reload_sudoers"
      systemctl daemon-reload
      systemctl enable --now deep-sec-customer-sales.service
      systemctl enable --now deep-sec-admin-console.service
      echo "Deep Sec Customer Sales App is running on port 7777."
      echo "Deep Sec Administrator Console is running on port 7778."
  - path: /usr/local/sbin/install-deep-sec-vibe
    owner: root:root
    permissions: '0755'
    content: |
      #!/usr/bin/env bash
      set -Eeuo pipefail

      home_dir=/home/opc
      archive="$home_dir/vibe-cli.zip"
      source_dir="$home_dir/vibe-cli"
      vibe_base=/opt/deep-sec-vibe
      vibe_home="$vibe_base/home"
      vibe_bin_dir="$vibe_base/bin"
      vibe_config_dir="$vibe_base/config"
      customer_dir=/opt/deep-sec-customer-sales
      python_tag=$(/usr/bin/python3 -c 'import sys; print(f"py{sys.version_info.major}.{sys.version_info.minor}")')
      offline_wheelhouse="/opt/deep-sec-offline/wheelhouse/$python_tag"

      section() { printf '\n===== %s =====\n' "$1"; }

      [[ -s "$archive" ]] || { echo "Missing Vibe package: $archive" >&2; exit 1; }
      [[ -d "$customer_dir" ]] || { echo "Customer Sales App is missing: $customer_dir" >&2; exit 1; }
      section 'Install Vibe Coding'
      unzip -tqq "$archive"
      rm -rf "$source_dir" "$vibe_base"
      mkdir -p "$source_dir" "$vibe_base"
      unzip -q "$archive" -d "$source_dir"
      chown -R opc:opc "$source_dir" "$vibe_base"
      runuser -u opc -- env \
        VIBE_HOME="$vibe_home" \
        VIBE_BIN_DIR="$vibe_bin_dir" \
        VIBE_CONFIG_DIR="$vibe_config_dir" \
        PYTHON_BIN=/usr/bin/python3 \
        VIBE_OFFLINE_WHEELHOUSE="$offline_wheelhouse" \
        bash -c 'cd /home/opc/vibe-cli && ./install.sh --overwrite-config'
      section 'Verify Vibe Coding'
      restorecon -RF "$vibe_base"
      runuser -u opc -- env \
        VIBE_HOME="$vibe_home" \
        VIBE_CONFIG="$vibe_config_dir/config.toml" \
        VIBE_LAB_CONTEXT="$vibe_home/lab-context.md" \
        "$vibe_bin_dir/vibe" --project "$customer_dir" status
      echo "Deep Sec Demo Setup is ready."
runcmd:
  - [ /usr/local/sbin/bootstrap-deep-sec ]
