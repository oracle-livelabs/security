FLASK_HOST=0.0.0.0
FLASK_PORT=7777
FLASK_DEBUG=false
FLASK_SECRET_KEY=replace-with-a-random-value

DB_DSN=
DB_SCHEMA=APPLAB
DB_WALLET_LOCATION=
DB_WALLET_PASSWORD=

# Students enter the Emma, Marvin, or Carol database password on the sign-in
# page. Never save those end-user passwords in this file.

OCI_REGION=us-ashburn-1
# The deployed compute host uses instance_principal. Set profile only for
# developer testing from a host with an OCI CLI/API-key profile.
OCI_AUTH_MODE=instance_principal
OCI_PROFILE=
# OCI_CONFIG_FILE=~/.oci/config
GENAI_COMPARTMENT_OCID=
GENAI_MODEL_ID=
