OCI_REGION=us-ashburn-1
# Select a named OCI CLI profile when testing another tenancy. Defaults to DEFAULT.
OCI_PROFILE=
# OCI_CONFIG_FILE=~/.oci/config
COMPARTMENT_OCID=
ADB_DISPLAY_NAME=DDS26AI
ADB_DB_NAME=DDS26AI
ADB_ADMIN_PASSWORD=
ADB_COMPUTE_COUNT=2
ADB_STORAGE_GB=20
ADB_LICENSE_MODEL=LICENSE_INCLUDED

COMPUTE_INSTANCE_OCID=
# Wallet transfer settings. The private key stays in Cloud Shell and is not
# copied to the compute instance.
COMPUTE_HOST=
COMPUTE_SSH_USER=opc
COMPUTE_SSH_PRIVATE_KEY=
COMPUTE_WALLET_STAGING_DIR=
COMPUTE_DYNAMIC_GROUP_NAME=DDS_LAB_COMPUTE
GENAI_MODEL_ID=
GENAI_COMPARTMENT_OCID=

# Existing Object Storage bucket for a short-lived wallet download PAR. The
# bucket itself must reside in the specified compartment when that value is set.
WALLET_BUCKET_NAME=
WALLET_BUCKET_COMPARTMENT_OCID=
WALLET_OBJECT_NAME=Wallet_DDS26AI.zip
WALLET_PAR_EXPIRY_HOURS=24
